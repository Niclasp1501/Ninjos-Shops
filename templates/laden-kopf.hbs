{{!--
  Kopf des Ladenbogens: das Ladeninnere als breiter Streifen, darauf Name und
  Begruessung, dazu das Zahnrad.

  Die Einstellungen standen hier einmal in einem <details> und fuellten
  aufgeklappt das halbe Fenster; die Auslage kam darunter nicht mehr vor. Sie
  haben jetzt ein eigenes Fenster (laden-einstellungen.js).

  Ein einziges Wurzelelement je PART, sonst wirft HandlebarsApplicationMixin
  beim Zeichnen. Siehe AGENTS.md.
--}}
<div class="shops-teil-kopf">
  {{!-- `kopfFokus` sagt, welcher Ausschnitt zu sehen ist - ein Innenraum ist
        selten in der Mitte am interessantesten. --}}
  <header class="shops-banner" style="background-image: url('{{document.img}}'); background-position: 50% {{laden.kopfFokus}}%;">
    <div class="shops-banner-text">
      <input type="text" name="name" value="{{document.name}}"
             placeholder="{{localize 'SHOPS.Bogen.NamePlatzhalter'}}"
             {{#unless bearbeitbar}}disabled{{/unless}}>

      <div class="shops-begruessung">
        {{#if begruessung}}{{{begruessung}}}
        {{else}}<span class="shops-leer">{{localize "SHOPS.Bogen.KeineBegruessung"}}</span>{{/if}}
      </div>
    </div>

    {{!--
      Der Verkäufer steht **rechts**, nicht klein unter dem Ladennamen. Er ist
      das Gegenüber im Handel und in beiden Büchern; als Zeile unter dem Namen
      las er sich wie eine Fußnote zum Laden. Hier ist er ein Gesicht neben
      dem Schild.
    --}}
    {{#if haendler}}
      <div class="shops-banner-haendler" title="{{localize 'SHOPS.Haendler.Feld'}}">
        {{#if haendler.img}}<img src="{{haendler.img}}" alt="">{{/if}}
        <span>
          <em>{{localize "SHOPS.Haendler.Marke"}}</em>
          <strong>{{haendler.name}}</strong>
        </span>
      </div>
    {{/if}}

    {{#if istGM}}
      <button type="button" class="shops-zahnrad" data-action="einstellungenOeffnen"
              title="{{localize 'SHOPS.Bogen.EinstellungenOeffnen'}}">
        <i class="fa-solid fa-sliders"></i>
      </button>
    {{/if}}
  </header>
</div>

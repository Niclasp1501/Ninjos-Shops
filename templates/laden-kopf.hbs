{{!--
  Kopf des Ladenbogens: Bild, Name, Begruessung, Zahnrad.

  Die Einstellungen standen hier einmal in einem <details> und fuellten
  aufgeklappt das halbe Fenster - sieben Felder mit je zwei Zeilen Erklaerung,
  und die Auslage kam darunter nicht mehr vor. Sie haben jetzt ein eigenes
  Fenster (laden-einstellungen.js); hier steht nur noch der Knopf dorthin.

  Ein einziges Wurzelelement je PART, sonst wirft HandlebarsApplicationMixin
  beim Zeichnen. Siehe AGENTS.md.
--}}
<div class="shops-teil-kopf">
  <header class="shops-kopf">
    {{!-- data-action="editImage" ist die Aktion von DocumentSheetV2; sie liest
         data-edit als Pfad des Feldes und oeffnet den Dateiwaehler. --}}
    <img class="shops-bild" src="{{document.img}}" alt="{{document.name}}"
         data-edit="img" data-action="editImage">

    <div class="shops-titel">
      <input type="text" name="name" value="{{document.name}}"
             placeholder="{{localize 'SHOPS.Bogen.NamePlatzhalter'}}"
             {{#unless bearbeitbar}}disabled{{/unless}}>

      <p class="shops-begruessung">
        {{#if begruessung}}{{{begruessung}}}
        {{else}}<span class="shops-leer">{{localize "SHOPS.Bogen.KeineBegruessung"}}</span>{{/if}}
      </p>
    </div>

    {{#if istGM}}
      <button type="button" class="shops-zahnrad" data-action="einstellungenOeffnen"
              title="{{localize 'SHOPS.Bogen.EinstellungenOeffnen'}}">
        <i class="fa-solid fa-sliders"></i>
      </button>
    {{/if}}
  </header>
</div>

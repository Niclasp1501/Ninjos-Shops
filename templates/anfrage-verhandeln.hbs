{{!--
  Verkaufsanfragen bei der Spielleitung.

  Die drei Zahlen rechts sieht **nur sie** - sie stehen gar nicht erst in der
  Fassung, die der Spieler bekommt. Untergrenze, üblicher Wert, Obergrenze:
  Wer den Händler verstimmt hat, bekommt die linke Zahl, wer gut mit ihm steht,
  die rechte. Entschieden wird am Tisch; das Modul rechnet nur.
--}}
<div class="shops-teil-verhandeln">

  {{!--
    Oben die Kaufwünsche, darunter die Verkaufsanfragen. Beides ist dasselbe
    Anliegen — ein Spieler fragt, die Spielleitung antwortet —, und beides an
    einer Stelle zu haben, erspart ein drittes Fenster, das man aufmachen muss,
    um zu sehen, ob etwas darin steht.
  --}}
  {{#if freigaben.length}}
    <ol class="shops-anfrageliste shops-freigabeliste">
      {{#each freigaben}}
        <li class="shops-anfrage shops-freigabe" data-freigabe-id="{{id}}">

          <header class="shops-anfrage-kopf">
            <i class="fa-solid fa-hand-holding" aria-hidden="true"></i>
            <strong>{{spielerName}}</strong>
            <span class="shops-anfrage-figur">{{figurName}}</span>
            <span class="shops-anfrage-laden">{{localize "SHOPS.Marktbuch.AnLaden" laden=ladenName}}</span>
          </header>

          <ol class="shops-ware shops-anfrage-posten">
            <li class="shops-zeile">
              {{#if img}}<img src="{{img}}" alt="">
              {{else}}<i class="fa-solid fa-cube shops-kein-bild" aria-hidden="true"></i>{{/if}}
              <div class="shops-name"><span class="shops-warenname">{{itemName}}</span></div>
              <span class="shops-menge">{{menge}}&times;</span>
              <span class="shops-preis">{{summeText}}</span>
            </li>
          </ol>

          <div class="shops-anfrage-felder">
            <label>
              <span>{{localize "SHOPS.Anfrage.Satz"}}</span>
              <input type="text" data-satz placeholder="{{localize 'SHOPS.Freigabe.SatzPlatzhalter'}}">
            </label>
          </div>

          <footer class="shops-anfrage-fuss">
            <button type="button" data-action="freigeben">
              <i class="fa-solid fa-check" aria-hidden="true"></i>
              {{localize "SHOPS.Freigabe.Freigeben"}}
            </button>
            <button type="button" class="shops-zweit" data-action="kaufAblehnen">
              <i class="fa-solid fa-hand" aria-hidden="true"></i>
              {{localize "SHOPS.Freigabe.Ablehnen"}}
            </button>
          </footer>

        </li>
      {{/each}}
    </ol>
  {{/if}}

  {{#if anfragen.length}}
    <ol class="shops-anfrageliste">
      {{#each anfragen}}
        <li class="shops-anfrage" data-anfrage-id="{{id}}">

          <header class="shops-anfrage-kopf">
            <strong>{{spielerName}}</strong>
            <span class="shops-anfrage-figur">{{figurName}}</span>
            <span class="shops-anfrage-laden">{{localize "SHOPS.Marktbuch.AnLaden" laden=gegenueberName}}</span>
            {{!-- Bei einer Person stammen die drei Zahlen unten aus keiner
                  Ladeneinstellung, sondern aus der halben Grundsumme. Das muss
                  dabeistehen, sonst liest man sie als Politik eines Ladens. --}}
            {{#unless istLaden}}
              <span class="shops-marke-person">{{localize "SHOPS.Anfrage.OhneLaden"}}</span>
            {{/unless}}
          </header>

          <ol class="shops-ware shops-anfrage-posten">
            {{#each posten}}
              <li class="shops-zeile">
                {{!-- Nicht jedes Stueck hat ein Bild. Ein leerer weisser Kasten
                      sieht aus wie ein Ladefehler, ein Symbol nicht. --}}
                {{#if img}}<img src="{{img}}" alt="">
                {{else}}<i class="fa-solid fa-cube shops-kein-bild" aria-hidden="true"></i>{{/if}}
                <div class="shops-name"><span class="shops-warenname">{{name}}</span></div>
                <span class="shops-menge">{{menge}}&times;</span>
                <span class="shops-preis">{{wertText}}</span>
              </li>
            {{/each}}
          </ol>

          {{!-- Nur für die Spielleitung. Die Knöpfe schreiben den Wert ins Feld,
                damit niemand eine Zahl abtippen muss, die daneben steht. --}}
          <div class="shops-spielraum">
            <span class="shops-spielraum-kopf">{{localize "SHOPS.Anfrage.NurFuerDich"}}</span>
            {{#if ohneWert}}
              {{!-- Drei Nullen nebeneinander sehen aus wie ein Fehler. Wenn am
                    Stueck kein Preis haengt, sagen wir das lieber. --}}
              <p class="shops-spielraum-leer">{{localize "SHOPS.Anfrage.KeinWert"}}</p>
            {{else}}
            <div class="shops-spielraum-werte">
              <button type="button" data-action="uebernehmen" data-wert="{{untenCp}}"
                      title="{{localize 'SHOPS.Anfrage.UntenHinweis'}}">
                <small>{{localize "SHOPS.Anfrage.Unten"}}</small>
                <strong>{{untenText}}</strong>
              </button>
              <button type="button" class="shops-ueblich" data-action="uebernehmen" data-wert="{{ueblichCp}}"
                      title="{{localize 'SHOPS.Anfrage.UeblichHinweis'}}">
                <small>{{localize "SHOPS.Anfrage.Ueblich"}}</small>
                <strong>{{ueblichText}}</strong>
              </button>
              <button type="button" data-action="uebernehmen" data-wert="{{obenCp}}"
                      title="{{localize 'SHOPS.Anfrage.ObenHinweis'}}">
                <small>{{localize "SHOPS.Anfrage.Oben"}}</small>
                <strong>{{obenText}}</strong>
              </button>
            </div>
            {{/if}}
          </div>

          {{#if vorgeschlagen}}
            <p class="shops-blockhinweis">
              {{localize "SHOPS.Anfrage.Geboten"}} <strong>{{angebotText}}</strong> —
              {{localize "SHOPS.Anfrage.WartetAufAntwort"}}
            </p>
          {{/if}}

          <div class="shops-anfrage-felder">
            <label>
              <span>{{localize "SHOPS.Anfrage.DeinPreis"}}</span>
              <span class="shops-preisfeld">
                {{!-- Zahl **und** Münzsorte. Nur Gold hieß: sechs Silber tippt
                      man als „0,6", drei Kupfer gar nicht. --}}
                <input type="number" data-preis min="0" step="1" placeholder="0">
                <select data-sorte aria-label="{{localize 'SHOPS.Muenze.Sorte'}}">
                  {{#each ../muenzsorten}}
                    <option value="{{sorte}}">{{kuerzel}}</option>
                  {{/each}}
                </select>
              </span>
            </label>
            <label>
              <span>{{localize "SHOPS.Anfrage.Satz"}}</span>
              <input type="text" data-satz placeholder="{{localize 'SHOPS.Anfrage.SatzPlatzhalter'}}">
            </label>
          </div>

          <footer class="shops-anfrage-fuss">
            <button type="button" data-action="bieten">
              <i class="fa-solid fa-hand-holding" aria-hidden="true"></i>
              {{localize "SHOPS.Anfrage.Bieten"}}
            </button>
            <button type="button" class="shops-zweit" data-action="abweisen">
              <i class="fa-solid fa-hand" aria-hidden="true"></i>
              {{localize "SHOPS.Anfrage.Abweisen"}}
            </button>
          </footer>

        </li>
      {{/each}}
    </ol>
  {{else}}
    {{#unless freigaben.length}}
      <p class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Anfrage.KeineOffen"}}</p>
    {{/unless}}
  {{/if}}
</div>

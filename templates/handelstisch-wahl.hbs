{{!--
  Die Lage über dem Tisch, in der man aussucht.

  Eine Vorlage für beide Fenster: Der Spieler sucht aus seinem Beutel, die
  Spielleitung aus dem der Person. Zeilen sind 44 Pixel hoch und werden als
  Ganzes angetippt; Mengen und Münzen haben dieselben Stufenknöpfe.
--}}
<div class="shops-wahl" role="dialog" aria-modal="true"
     aria-label="{{#if wahl.sachenModus}}{{localize 'SHOPS.Tisch.Sachen'}}{{else}}{{localize 'SHOPS.Tisch.Muenzen'}}{{/if}}">

  <div class="shops-wahl-kopf">
    <h3>
      {{#if wahl.sachenModus}}
        <i class="fa-solid fa-box-open" aria-hidden="true"></i> {{localize "SHOPS.Tisch.Sachen"}}
      {{else}}
        <i class="fa-solid fa-coins" aria-hidden="true"></i> {{localize "SHOPS.Tisch.Muenzen"}}
      {{/if}}
    </h3>
    <button type="button" class="shops-kaufen shops-zweit" data-action="wahlZurueck">
      {{localize "SHOPS.Tisch.Zurueck"}}
    </button>
  </div>

  <div class="shops-wahl-liste">
    {{#if wahl.sachenModus}}

      {{#if wahl.hatZeilen}}
        {{#each wahl.zeilen}}
          <div class="shops-wahl-zeile {{#if an}}shops-an{{/if}}">
            <div class="shops-wahl-tipp" data-action="wahlUmschalten" data-item-id="{{id}}">
              {{#if img}}<img src="{{img}}" alt="">
              {{else}}<i class="fa-solid fa-cube shops-kein-bild" aria-hidden="true"></i>{{/if}}
              <span class="shops-wahl-name">
                {{name}}
                {{#if stapel}}<em>{{localize "SHOPS.Tisch.Hast" anzahl=hoechstens}}</em>{{/if}}
              </span>
            </div>
            {{#if stapel}}
              <div class="shops-schritt">
                <button type="button" class="shops-klein" data-action="wahlNichts" data-item-id="{{id}}">0</button>
                <button type="button" data-action="wahlWeniger" data-item-id="{{id}}" data-hoechstens="{{hoechstens}}" data-schritt="10">&minus;10</button>
                <button type="button" data-action="wahlWeniger" data-item-id="{{id}}" data-hoechstens="{{hoechstens}}">&minus;</button>
                <span>{{gewaehlt}}</span>
                <button type="button" data-action="wahlMehr" data-item-id="{{id}}" data-hoechstens="{{hoechstens}}">+</button>
                <button type="button" data-action="wahlMehr" data-item-id="{{id}}" data-hoechstens="{{hoechstens}}" data-schritt="10">+10</button>
                <button type="button" class="shops-klein" data-action="wahlAlles" data-item-id="{{id}}" data-hoechstens="{{hoechstens}}">
                  {{localize "SHOPS.Tisch.Alles"}}
                </button>
              </div>
            {{else}}
              <i class="fa-solid {{#if an}}fa-circle-check{{else}}fa-circle{{/if}} shops-wahl-marke" aria-hidden="true"></i>
            {{/if}}
          </div>
        {{/each}}
      {{else}}
        <p class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Tisch.KeineSachen"}}</p>
      {{/if}}

    {{else}}

      {{#if wahl.hatMuenzen}}
        {{#each wahl.muenzen}}
          <div class="shops-wahl-zeile {{#if an}}shops-an{{/if}}">
            <span class="shops-wahl-name shops-wahl-muenze">
              <i class="fa-solid fa-coins" aria-hidden="true"></i>
              {{kuerzel}} <em>{{localize "SHOPS.Tisch.Hast" anzahl=habe}}</em>
            </span>
            <div class="shops-schritt">
              <button type="button" class="shops-klein" data-action="muenzeNichts" data-sorte="{{sorte}}">0</button>
              <button type="button" data-action="muenzeWeniger" data-sorte="{{sorte}}" data-habe="{{habe}}" data-schritt="10">&minus;10</button>
              <button type="button" data-action="muenzeWeniger" data-sorte="{{sorte}}" data-habe="{{habe}}">&minus;</button>
              <span>{{gewaehlt}}</span>
              <button type="button" data-action="muenzeMehr" data-sorte="{{sorte}}" data-habe="{{habe}}">+</button>
              <button type="button" data-action="muenzeMehr" data-sorte="{{sorte}}" data-habe="{{habe}}" data-schritt="10">+10</button>
              <button type="button" class="shops-klein" data-action="muenzeAlles" data-sorte="{{sorte}}" data-habe="{{habe}}">
                {{localize "SHOPS.Tisch.Alles"}}
              </button>
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Tisch.KeineMuenzen"}}</p>
      {{/if}}

    {{/if}}
  </div>

  <footer class="shops-wahl-fuss">
    <button type="button" class="shops-kaufen shops-zweit" data-action="wahlZurueck">
      {{localize "SHOPS.Abbrechen"}}
    </button>
    <button type="button" class="shops-kaufen" data-action="wahlAufDenTisch">
      <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
      {{localize "SHOPS.Tisch.Auflegen"}}
    </button>
  </footer>
</div>

{{!--
  Ein Stück aus der Nähe.

  Was im Regal steht, ist eine Zeile; wer sich dafür interessiert, will das
  Bild groß, die Beschreibung ganz und den Preis daneben — und dann kaufen,
  ohne zurückzublättern.
--}}
<div class="shops-teil-ansehen">

  <header class="shops-ansehen-kopf">
    <img src="{{img}}" alt="">
    <div>
      <h2>{{name}}</h2>
      {{#if hinweis}}<p class="shops-ansehen-hinweis">{{hinweis}}</p>{{/if}}
      <div class="shops-ansehen-zahlen">
        <span class="shops-ansehen-preis">{{preisText}}</span>
        {{#if dienst}}
          <span class="shops-marke-dienst">{{localize "SHOPS.Bogen.Dienst"}}</span>
        {{else}}
          <span class="shops-ansehen-bestand">
            {{localize "SHOPS.Bogen.SpalteBestand"}} <strong>{{menge}}</strong>
          </span>
        {{/if}}
      </div>
    </div>
  </header>

  {{#if beschreibung}}
    <div class="shops-ansehen-text">{{{beschreibung}}}</div>
  {{else}}
    <p class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Ansehen.KeineBeschreibung"}}</p>
  {{/if}}

  {{#if kaufbar}}
    <footer class="shops-ansehen-fuss">
      <button type="button" class="shops-kaufen" data-action="hierKaufen">
        <i class="fa-solid fa-hand-holding" aria-hidden="true"></i>
        {{localize "SHOPS.Spieler.Kaufen"}} — {{preisText}}
      </button>
    </footer>
  {{/if}}
</div>

{{!--
  Die Auslage.

  Eine Zeile je Gegenstand. Was hier steht, ist eine Anzeige - beim Kauf wird
  der Preis beim Spielleiter neu gerechnet (KONZEPT-shops.md, Abschnitt 7).
--}}

<section class="shops-auslage">
  <h3>
    {{localize "SHOPS.Bogen.Auslage"}}
    <span class="shops-anzahl">{{ware.length}}</span>
  </h3>

  {{#if ware.length}}

    <ol class="shops-ware">
      {{!-- Der Spaltenkopf spiegelt die Breiten der Zeile darunter; wer eine
      davon aendert, aendert beide. --}}
      <li class="shops-spalten">
        <span class="shops-spalte-bild"></span>
        <span class="shops-spalte-name">{{localize "SHOPS.Bogen.SpalteWare"}}</span>
        <span class="shops-spalte-menge">{{localize "SHOPS.Bogen.SpalteBestand"}}</span>
        <span class="shops-spalte-preis">{{localize "SHOPS.Bogen.SpaltePreis"}}</span>
        {{!-- Derselbe Aufbau wie in der Karte: Festpreis und Schalter liegen
              dort in einer gemeinsamen Gruppe mit eigenem Abstand. Zwei lose
              Spalten daneben ergaben acht Pixel Versatz. --}}
        <span class="shops-werkzeuge">
          <span class="shops-spalte-fest">{{localize "SHOPS.Bogen.SpalteFestpreis"}}</span>
          <span class="shops-spalte-schalter"></span>
        </span>
      </li>
      {{#each ware}}
        <li class="shops-zeile {{#if verborgen}}shops-verborgen{{/if}}" data-item-id="{{id}}">
          <img src="{{img}}" alt="" data-action="wareOeffnen">

          <div class="shops-name">
            <span class="shops-warenname" data-action="wareOeffnen">
              {{name}}
              {{!-- Zustand bleibt sichtbar, auch wenn die Handlungen im Menü
                    liegen. Etwas, das man nur nach dem Aufklappen erfährt,
                    hat man beim Überfliegen nicht. --}}
              {{#if verborgen}}<i class="fa-solid fa-eye-slash shops-marke"
                    title="{{localize 'SHOPS.Bogen.Verborgen'}}" aria-hidden="true"></i>{{/if}}
              {{#if dienst}}<i class="fa-solid fa-handshake shops-marke"
                    title="{{localize 'SHOPS.Bogen.Dienst'}}" aria-hidden="true"></i>{{/if}}
              {{#if ankauf}}<i class="fa-solid fa-arrow-rotate-left shops-marke"
                    title="{{localize 'SHOPS.Bogen.KauftAn'}}" aria-hidden="true"></i>{{/if}}
            </span>
            <input type="text" data-ware-feld="hinweis" value="{{hinweis}}"
                   placeholder="{{localize 'SHOPS.Bogen.HinweisPlatzhalter'}}"
                   {{#unless @root.bearbeitbar}}disabled{{/unless}}>
          </div>

          <label class="shops-menge" title="{{localize 'SHOPS.Bogen.Menge'}}">
            <input type="number" data-ware-feld="menge" value="{{menge}}" min="0" step="1"
                   {{#unless @root.bearbeitbar}}disabled{{/unless}}>
          </label>

          <div class="shops-preise">
            <span class="shops-preis {{#if hatFestpreis}}shops-fest{{/if}}"
                  title="{{localize 'SHOPS.Bogen.Grundpreis'}}: {{grundText}}">{{preisText}}</span>
            {{#if ankaufText}}
              <span class="shops-ankauf" title="{{localize 'SHOPS.Bogen.Ankauf'}}">{{ankaufText}}</span>
            {{/if}}
          </div>

          {{!--
            Leeres Feld = kein Festpreis, also Aufschlag auf den Grundpreis.
            Eine 0 = geschenkt. Das ist ein Unterschied, und er ist gewollt.
          --}}
          {{!-- Festpreis und Schalter sind Werkzeuge, keine Auskunft: Sie
                treten zurueck, bis die Karte gemeint ist. Vorher trug jede
                Zeile sechs Bedienelemente gleichzeitig. --}}
          <div class="shops-werkzeuge">
          <div class="shops-festpreis" data-ware-feld="festpreis"
               title="{{localize 'SHOPS.Bogen.FestpreisHinweis'}}">
            {{> "shops-muenzfelder" felder=festFelder gesperrt=@root.gesperrt}}
          </div>

          {{!-- Ein Knopf statt fünf. Fünf blasse Symbole nebeneinander
                lesen sich als grauer Schleier, nicht als fünf Schalter -
                und vier davon braucht man selten. --}}
          <button type="button" class="shops-zeilenmenue" data-action="wareMenue"
                  title="{{localize 'SHOPS.Bogen.Mehr'}}"
                  {{#unless @root.bearbeitbar}}disabled{{/unless}} aria-label="{{localize 'SHOPS.Bogen.Mehr'}}">
            <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
          </button>
          </div>
        </li>
      {{/each}}
    </ol>
  {{else}}
    <p class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Bogen.AuslageLeer"}}</p>
  {{/if}}
</section>

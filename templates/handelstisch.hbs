{{!--
  Der Handelstisch, Seite des Spielers.

  Ein Blatt: links, was ich hinlege, rechts, was sie hinlegt, unten die
  Differenz. Kein Blättern, kein zweites Fenster, kein Zahlenfeld — was der
  Tausch kostet, steht da, während man ihn zusammenstellt.
--}}
<div class="shops-teil-tisch">

  {{#if stand}}
    <header class="shops-tisch-kopf">
      {{#if stand.personBild}}
        <img src="{{stand.personBild}}" alt="">
      {{/if}}
      <div>
        <strong>{{stand.personName}}</strong>
        {{#if stand.satz}}<span class="shops-tisch-satz">„{{stand.satz}}"</span>{{/if}}
      </div>
      {{#if figurName}}
        <span class="shops-boerse">
          <i class="fa-solid fa-coins" aria-hidden="true"></i>
          <span class="shops-boerse-label">{{figurName}}</span>
          <strong>{{boerse}}</strong>
        </span>
      {{/if}}
    </header>

    <div class="shops-tisch-platte">

      <section class="shops-tisch-seite" data-seite="spieler">
        <h3>{{localize "SHOPS.Tisch.DuGibst"}}</h3>
        <ol class="shops-ware shops-tisch-spieler">
          {{#each stand.seiteSpieler}}
            <li class="shops-zeile" data-item-id="{{itemId}}">
              {{#if img}}<img src="{{img}}" alt="" data-action="ansehen"
                              title="{{localize 'SHOPS.Ansehen.Knopf'}}">
              {{else}}<i class="fa-solid fa-cube shops-kein-bild" aria-hidden="true"></i>{{/if}}
              <div class="shops-name">
                <span class="shops-warenname" data-action="ansehen"
                      title="{{localize 'SHOPS.Ansehen.Knopf'}}">{{name}}</span>
                {{#if grundText}}<small class="shops-grundpreis">{{localize "SHOPS.Tisch.Grundpreis"}} {{grundText}}</small>{{/if}}
                {{#if darinEtwas}}
                  {{!-- Was im Beutel liegt, gehört zu dem, was zugesagt wird —
                        also muss man es sehen. --}}
                  <small class="shops-inhalt">{{localize "SHOPS.Tisch.Darin"}}
                    {{#each inhalt}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}{{#if inhaltGeldText}}{{#if inhalt.length}} &middot; {{/if}}{{inhaltGeldText}}{{/if}}</small>
                {{/if}}
              </div>
              <span class="shops-menge">{{menge}}&times;</span>
              {{!-- Was ich dafür haben will. Ein Tipp ändert es jederzeit. --}}
              <button type="button" class="shops-tisch-preis {{#unless hatPreis}}shops-offen{{/unless}}"
                      data-action="preisNennen"
                      title="{{localize 'SHOPS.Tisch.PreisAendern'}}"
                      aria-label="{{localize 'SHOPS.Tisch.PreisAendern'}}: {{name}}">
                {{#if hatPreis}}{{preisText}}
                {{else}}<i class="fa-solid fa-tag" aria-hidden="true"></i> {{localize "SHOPS.Tisch.PreisNennen"}}{{/if}}
              </button>
              <button type="button" class="shops-tisch-weg" data-action="wegnehmen"
                      aria-label="{{localize 'SHOPS.Tisch.Wegnehmen'}}"
                      title="{{localize 'SHOPS.Tisch.Wegnehmen'}}">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            </li>
          {{/each}}
          {{#if stand.geldSpieler}}
            <li class="shops-zeile shops-geldzeile">
              <i class="fa-solid fa-coins" aria-hidden="true"></i>
              <div class="shops-name"><span class="shops-warenname">{{localize "SHOPS.Tisch.Geld"}}</span></div>
              <span class="shops-preis">{{stand.geldSpielerText}}</span>
              <button type="button" class="shops-tisch-weg" data-action="geldWeg"
                      aria-label="{{localize 'SHOPS.Tisch.GeldWeg'}}"
                      title="{{localize 'SHOPS.Tisch.GeldWeg'}}">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            </li>
          {{/if}}
          {{#unless stand.seiteSpieler.length}}{{#unless stand.geldSpieler}}
            <li class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Tisch.DuLegstNichts"}}</li>
          {{/unless}}{{/unless}}
        </ol>
        {{!-- Aussuchen passiert in einer Lage über dem Tisch — siehe
              tisch-wahl.js. Hier stehen nur die zwei Knöpfe, die sie öffnen. --}}
        <div class="shops-tisch-werkzeuge">
          <button type="button" class="shops-kaufen shops-zweit" data-action="wahlSachen">
            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
            {{localize "SHOPS.Tisch.Sachen"}}
          </button>
          <button type="button" class="shops-kaufen shops-zweit" data-action="wahlMuenzen">
            <i class="fa-solid fa-coins" aria-hidden="true"></i>
            {{localize "SHOPS.Tisch.Muenzen"}}
          </button>
        </div>
      </section>

      <section class="shops-tisch-seite" data-seite="nsc">
        <h3>{{localize "SHOPS.Tisch.SieGibt" person=stand.personName}}</h3>
        <ol class="shops-ware shops-tisch-nsc">
          {{#each stand.seiteNsc}}
            {{!-- Anklickbar nur, wenn die Spielleitung es erlaubt. Das
                  Detailfenster verriete, was ein Haendler lieber erst beim
                  Benutzen herauskommen laesst. --}}
            <li class="shops-zeile" data-item-id="{{itemId}}">
              {{#if img}}<img src="{{img}}" alt=""{{#if @root.nscAnsehen}} data-action="ansehen"
                              title="{{localize 'SHOPS.Ansehen.Knopf'}}"{{/if}}>
              {{else}}<i class="fa-solid fa-cube shops-kein-bild" aria-hidden="true"></i>{{/if}}
              <div class="shops-name">
                <span class="shops-warenname"{{#if @root.nscAnsehen}} data-action="ansehen"
                      title="{{localize 'SHOPS.Ansehen.Knopf'}}"{{/if}}>{{name}}</span>
                {{#if darinEtwas}}
                  {{!-- Was im Beutel liegt, gehört zu dem, was zugesagt wird —
                        also muss man es sehen. --}}
                  <small class="shops-inhalt">{{localize "SHOPS.Tisch.Darin"}}
                    {{#each inhalt}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}{{#if inhaltGeldText}}{{#if inhalt.length}} &middot; {{/if}}{{inhaltGeldText}}{{/if}}</small>
                {{/if}}
              </div>
              {{!-- Was sie dafür haben will, so wie die Spielleitung es
                    genannt hat. Kein gerechneter Preis. --}}
              <span class="shops-menge">{{menge}}&times;</span>
              <span class="shops-preis">{{#if hatPreis}}{{preisText}}{{else}}<em class="shops-ohne-preis">{{localize "SHOPS.Tisch.OhnePreis"}}</em>{{/if}}</span>
            </li>
          {{/each}}
          {{#if stand.geldNsc}}
            <li class="shops-zeile shops-geldzeile">
              <i class="fa-solid fa-coins" aria-hidden="true"></i>
              <div class="shops-name"><span class="shops-warenname">{{localize "SHOPS.Tisch.Geld"}}</span></div>
              <span class="shops-preis">{{stand.geldNscText}}</span>
            </li>
          {{/if}}
          {{#unless stand.seiteNsc.length}}{{#unless stand.geldNsc}}
            <li class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Tisch.SieLegtNichts"}}</li>
          {{/unless}}{{/unless}}
        </ol>
      </section>
    </div>

    {{!-- Die Waage. Sie ist der eigentliche Grund für dieses Fenster: Man
          sieht, was der Tausch kostet, während man ihn zusammenstellt. --}}
    {{!-- Die Waage. Sie ist der eigentliche Grund für dieses Fenster: Was sie
          will, was ich bringe, was dazwischen fehlt. --}}
    <div class="shops-tisch-waage {{#if stand.fehlt}}shops-zahlt{{/if}}
                {{#if stand.zuViel}}shops-bekommt{{/if}}">
      {{!-- Die eigene Seite links, wie auf dem Tisch darueber. --}}
      <span class="shops-tisch-summe">
        <small>{{localize "SHOPS.Tisch.Du"}}</small> {{stand.rechtsText}}
      </span>
      <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
      <span class="shops-tisch-summe">
        <small>{{stand.personName}}</small> {{stand.linksText}}
      </span>
      <strong class="shops-tisch-differenz">
        {{#if stand.ausgeglichen}}{{localize "SHOPS.Tisch.Ausgeglichen"}}
        {{else if stand.fehlt}}{{localize "SHOPS.Tisch.Fehlt" geld=stand.offenText}}
        {{else}}{{localize "SHOPS.Tisch.ZuViel" geld=stand.offenText}}{{/if}}
      </strong>
      {{#if stand.wechselCp}}
        {{!-- Wechselgeld ist kein Fehler auf der Waage, sondern Teil des
              Tauschs. Deshalb steht es daneben und nicht als „zu viel". --}}
        <span class="shops-tisch-wechsel">
          <i class="fa-solid fa-coins" aria-hidden="true"></i>
          {{#if stand.wechselAnSpieler}}{{localize "SHOPS.Tisch.WechselDu" geld=stand.wechselText}}
          {{else}}{{localize "SHOPS.Tisch.WechselAn" wer=stand.personName geld=stand.wechselText}}{{/if}}
        </span>
      {{/if}}
    </div>
    {{#if stand.passend}}
      <p class="shops-blockhinweis shops-tisch-passend-hinweis">
        <i class="fa-solid fa-hand-holding-dollar" aria-hidden="true"></i>
        {{localize "SHOPS.Tisch.PassendHinweis" person=stand.personName}}
      </p>
    {{/if}}

    <footer class="shops-tisch-fuss">
      {{!-- **Der Knopf sagt, was das Drücken jetzt bewirkt.** Vorher stand dort
            immer „Handel abschließen" — auch dann, wenn die andere Seite noch
            gar nicht zugesagt hatte und gar nichts abgeschlossen wurde. Also:
            zusagen, solange nur die eigene Zusage entsteht; abschließen erst,
            wenn die andere schon steht und der Druck den Tausch wirklich
            ausführt; und zurücknehmen, wenn man selbst schon zugesagt hat. --}}
      <button type="button" class="shops-kaufen {{#if stand.bereitSpieler}}shops-zweit{{/if}}"
              data-action="annehmen"
              {{#if stand.leer}}disabled
              {{else if stand.ohneSpielleitung}}disabled
              {{/if}}>
        <i class="fa-solid {{#if stand.bereitSpieler}}fa-rotate-left{{else if stand.bereitGm}}fa-check{{else}}fa-handshake{{/if}}"
           aria-hidden="true"></i>
        {{#if stand.bereitSpieler}}{{localize "SHOPS.Tisch.ZusageZurueck"}}
        {{else if stand.bereitGm}}{{localize "SHOPS.Tisch.Abschliessen"}}
        {{else}}{{localize "SHOPS.Tisch.Zusagen"}}{{/if}}
      </button>
      {{#if stand.bereitSpieler}}
        <span class="shops-tisch-zusage">
          {{localize "SHOPS.Tisch.WartetAufSie" person=stand.personName}}
        </span>
      {{else if stand.bereitGm}}
        <span class="shops-tisch-zusage shops-zugesagt">
          {{localize "SHOPS.Tisch.SieHatZugesagt" person=stand.personName}}
        </span>
      {{/if}}
      {{#unless stand.allePreise}}
        {{!-- Ein Posten ohne Preis ist eine offene Frage. Zusagen geht
              trotzdem, aber erst nach einer Warnung. --}}
        <span class="shops-tisch-zusage shops-wartet">
          <i class="fa-solid fa-tag" aria-hidden="true"></i>
          {{localize "SHOPS.Tisch.PreiseFehlen" namen=stand.ohnePreisNamen}}
        </span>
      {{/unless}}
      {{#if stand.zusageWegSpieler}}
        {{!-- Eine Zusage, die wegfaellt, faellt nicht stillschweigend weg. --}}
        <span class="shops-tisch-zusage shops-wartet">
          <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
          {{localize "SHOPS.Tisch.ZusageWeg"}}
        </span>
      {{/if}}
      {{#if stand.ohneSpielleitung}}
        {{!-- Ohne Spielleitung fuehrt niemand aus. Das steht im Fenster und
              nicht als Meldung: Eine Meldung verschwindet, und in der
              Blattansicht wird sie ganz ausgeblendet. --}}
        <span class="shops-tisch-zusage shops-wartet">
          <i class="fa-solid fa-user-slash" aria-hidden="true"></i>
          {{localize "SHOPS.Tisch.OhneSpielleitung"}}
        </span>
      {{/if}}
      {{!-- Abgesetzt nach rechts: „abschließen" und „beenden" nebeneinander
            sind auf einem Tablet ein Vertipper auseinander. --}}
      <button type="button" class="shops-kaufen shops-zweit shops-abseits" data-action="aufgeben">
        <i class="fa-solid fa-hand" aria-hidden="true"></i>
        {{localize "SHOPS.Tisch.Aufgeben"}}
      </button>
    </footer>

    {{#if wahl}}{{> "shops-tisch-wahl" wahl=wahl}}{{/if}}

  {{else}}
    <p class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Handel.NichtsVorgelegt"}}</p>
  {{/if}}
</div>

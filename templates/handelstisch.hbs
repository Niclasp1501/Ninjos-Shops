{{!--
  Der Handelstisch, Seite des Spielers.

  Ein Blatt: links, was sie hinlegt, rechts, was ich hinlege, unten die
  Differenz. Kein Blättern, kein zweites Fenster, kein Zahlenfeld — was der
  Tausch kostet, steht da, während man ihn zusammenstellt.
--}}
<div class="shops-teil-tisch">

  {{#if stand}}
    <header class="shops-tisch-kopf">
      {{#if stand.personBild}}
        <img src="{{stand.personBild}}" alt="">
      {{/if}}
      <div>
        <strong>{{stand.personName}}</strong>
        {{#if stand.satz}}<span class="shops-tisch-satz">„{{stand.satz}}"</span>{{/if}}
      </div>
      {{#if figurName}}
        <span class="shops-boerse">
          <i class="fa-solid fa-coins" aria-hidden="true"></i>
          <span class="shops-boerse-label">{{figurName}}</span>
          <strong>{{boerse}}</strong>
        </span>
      {{/if}}
    </header>

    <div class="shops-tisch-platte">

      <section class="shops-tisch-seite" data-seite="nsc">
        <h3>{{localize "SHOPS.Tisch.SieGibt" person=stand.personName}}</h3>
        <ol class="shops-ware shops-tisch-nsc">
          {{#each stand.seiteNsc}}
            <li class="shops-zeile" data-item-id="{{itemId}}">
              {{#if img}}<img src="{{img}}" alt="" data-action="ansehen"
                              title="{{localize 'SHOPS.Ansehen.Knopf'}}">
              {{else}}<i class="fa-solid fa-cube shops-kein-bild" aria-hidden="true"></i>{{/if}}
              <div class="shops-name">
                <span class="shops-warenname" data-action="ansehen"
                      title="{{localize 'SHOPS.Ansehen.Knopf'}}">{{name}}</span>
              </div>
              <span class="shops-menge">{{menge}}&times;</span>
              <span class="shops-preis">{{summeText}}</span>
            </li>
          {{/each}}
          {{#if stand.geldNsc}}
            <li class="shops-zeile shops-geldzeile">
              <i class="fa-solid fa-coins" aria-hidden="true"></i>
              <div class="shops-name"><span class="shops-warenname">{{localize "SHOPS.Tisch.Geld"}}</span></div>
              <span class="shops-preis">{{stand.geldNscText}}</span>
            </li>
          {{/if}}
          {{#unless stand.seiteNsc.length}}{{#unless stand.geldNsc}}
            <li class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Tisch.SieLegtNichts"}}</li>
          {{/unless}}{{/unless}}
        </ol>
      </section>

      <section class="shops-tisch-seite" data-seite="spieler">
        <h3>{{localize "SHOPS.Tisch.DuGibst"}}</h3>
        <ol class="shops-ware shops-tisch-spieler">
          {{#each stand.seiteSpieler}}
            <li class="shops-zeile" data-item-id="{{itemId}}">
              {{#if img}}<img src="{{img}}" alt="" data-action="ansehen"
                              title="{{localize 'SHOPS.Ansehen.Knopf'}}">
              {{else}}<i class="fa-solid fa-cube shops-kein-bild" aria-hidden="true"></i>{{/if}}
              <div class="shops-name">
                <span class="shops-warenname" data-action="ansehen"
                      title="{{localize 'SHOPS.Ansehen.Knopf'}}">{{name}}</span>
              </div>
              <span class="shops-menge">{{menge}}&times;</span>
              <span class="shops-preis">{{summeText}}</span>
              <button type="button" class="shops-tisch-weg" data-action="wegnehmen"
                      aria-label="{{localize 'SHOPS.Tisch.Wegnehmen'}}"
                      title="{{localize 'SHOPS.Tisch.Wegnehmen'}}">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            </li>
          {{/each}}
          {{#if stand.geldSpieler}}
            <li class="shops-zeile shops-geldzeile">
              <i class="fa-solid fa-coins" aria-hidden="true"></i>
              <div class="shops-name"><span class="shops-warenname">{{localize "SHOPS.Tisch.Geld"}}</span></div>
              <span class="shops-preis">{{stand.geldSpielerText}}</span>
              <button type="button" class="shops-tisch-weg" data-action="geldWeg"
                      aria-label="{{localize 'SHOPS.Tisch.GeldWeg'}}"
                      title="{{localize 'SHOPS.Tisch.GeldWeg'}}">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            </li>
          {{/if}}
        </ol>
        {{!-- Geld ist ein Ding, das man hinlegt — keine Sonderrechnung. Was
              hier steht, zählt sofort in der Waage darunter. --}}
        <div class="shops-geldfeld">
          <i class="fa-solid fa-coins" aria-hidden="true"></i>
          <label>
            <span>{{localize "SHOPS.Tisch.GeldDazu"}}</span>
            <span class="shops-preisfeld">
              <input type="number" data-geld min="0" step="1" value="{{stand.geldSpielerFeld.value}}"
                     aria-label="{{localize 'SHOPS.Tisch.GeldDazu'}}">
              <select data-geldsorte aria-label="{{localize 'SHOPS.Muenze.Sorte'}}">
                {{#each muenzsorten}}
                  <option value="{{sorte}}" {{#if (eq sorte ../stand.geldSpielerFeld.denomination)}}selected{{/if}}>{{kuerzel}}</option>
                {{/each}}
              </select>
            </span>
          </label>
          <button type="button" class="shops-kaufen shops-zweit" data-action="geldLegen">
            {{localize "SHOPS.Tisch.GeldLegen"}}
          </button>
        </div>
      </section>
    </div>

    {{!-- Die Waage. Sie ist der eigentliche Grund für dieses Fenster: Man
          sieht, was der Tausch kostet, während man ihn zusammenstellt. --}}
    <div class="shops-tisch-waage {{#if stand.zahltSpieler}}shops-zahlt{{/if}}
                {{#if stand.bekommtSpieler}}shops-bekommt{{/if}}">
      <span class="shops-tisch-summe">{{stand.nscText}}</span>
      <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
      <span class="shops-tisch-summe">{{stand.spielerText}}</span>
      <strong class="shops-tisch-differenz">
        {{#if stand.ausgeglichen}}
          {{localize "SHOPS.Tisch.Ausgeglichen"}}
        {{else if stand.zahltSpieler}}
          {{localize "SHOPS.Tisch.DuZahlst" geld=stand.differenzText}}
        {{else}}
          {{localize "SHOPS.Tisch.DuBekommst" geld=stand.differenzText}}
        {{/if}}
      </strong>
      {{#if stand.ueberschrieben}}
        <em class="shops-tisch-ausgehandelt">{{localize "SHOPS.Tisch.Ausgehandelt"}}</em>
      {{/if}}
    </div>

    {{#if vorrat.length}}
      {{!-- Offen: Das ist die Arbeitsfläche, nicht eine Fußnote. --}}
      <details class="shops-tisch-vorratsblock" open>
        <summary>{{localize "SHOPS.Tisch.WasDuHast"}}</summary>
        <ol class="shops-ware shops-tisch-vorrat">
          {{#each vorrat}}
            <li class="shops-zeile" data-item-id="{{id}}">
              {{#if img}}<img src="{{img}}" alt="">
              {{else}}<i class="fa-solid fa-cube shops-kein-bild" aria-hidden="true"></i>{{/if}}
              <div class="shops-name"><span class="shops-warenname">{{name}}</span></div>
              <label class="shops-handel-menge">
                <span>{{localize "SHOPS.Handel.Menge"}}</span>
                <input type="number" data-menge value="1" min="1" max="{{menge}}"
                       aria-label="{{localize 'SHOPS.Handel.Menge'}}">
              </label>
              <span class="shops-preis">{{wertText}}</span>
              <button type="button" class="shops-kaufen" data-action="auflegen">
                <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                {{localize "SHOPS.Tisch.Auflegen"}}
              </button>
            </li>
          {{/each}}
        </ol>
      </details>
    {{/if}}

    <footer class="shops-tisch-fuss">
      {{!-- Zwei Zusagen. Der Knopf zeigt, wo man steht: zusagen, warten, oder
            die Zusage zurücknehmen. --}}
      <button type="button" class="shops-kaufen {{#if stand.bereitSpieler}}shops-zweit{{/if}}"
              data-action="annehmen" {{#if stand.leer}}disabled{{/if}}>
        <i class="fa-solid {{#if stand.bereitSpieler}}fa-rotate-left{{else}}fa-handshake{{/if}}"
           aria-hidden="true"></i>
        {{#if stand.bereitSpieler}}{{localize "SHOPS.Tisch.ZusageZurueck"}}
        {{else}}{{localize "SHOPS.Tisch.Abschliessen"}}{{/if}}
      </button>
      {{#if stand.bereitSpieler}}
        <span class="shops-tisch-zusage">
          {{localize "SHOPS.Tisch.WartetAufSie" person=stand.personName}}
        </span>
      {{else if stand.bereitGm}}
        <span class="shops-tisch-zusage shops-zugesagt">
          {{localize "SHOPS.Tisch.SieHatZugesagt" person=stand.personName}}
        </span>
      {{/if}}
      {{!-- Abgesetzt nach rechts: „abschließen" und „beenden" nebeneinander
            sind auf einem Tablet ein Vertipper auseinander. --}}
      <button type="button" class="shops-kaufen shops-zweit shops-abseits" data-action="aufgeben">
        <i class="fa-solid fa-hand" aria-hidden="true"></i>
        {{localize "SHOPS.Tisch.Aufgeben"}}
      </button>
    </footer>

  {{else}}
    <p class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Handel.NichtsVorgelegt"}}</p>
  {{/if}}
</div>

{{!--
  Der Laden auf dem Bildschirm an der Wand.

  Aus zwei bis drei Metern lesbar: Bild groß, Name in Versalien, Preis als
  Zahl. Kein Regeltext — dafür ist die Hinweiszeile da, und die schreibt die
  Spielleitung. Und nichts, worauf man klicken könnte: Der Monitor hat keine
  Tastatur.
--}}
<div class="shops-schau-innen">

  <header class="shops-schau-kopf" style="--kopf-fokus: {{kopfFokus}}%">
    {{#if kopfBild}}<img src="{{kopfBild}}" alt="">{{/if}}
    <div class="shops-schau-titel">
      <h1>{{ladenName}}</h1>
      {{#if haendlerName}}
        <span class="shops-schau-haendler">
          {{#if haendlerBild}}<img src="{{haendlerBild}}" alt="">{{/if}}
          {{haendlerName}}
        </span>
      {{/if}}
      {{#if begruessung}}<p class="shops-schau-gruss">{{{begruessung}}}</p>{{/if}}
    </div>
  </header>

  {{#if waren.length}}
    <ol class="shops-schau-gitter">
      {{#each waren}}
        <li class="shops-schau-karte {{#if dienst}}shops-schau-dienst{{/if}}">
          <img src="{{img}}" alt="">
          <div class="shops-schau-text">
            <span class="shops-schau-name">{{name}}</span>
            {{#if hinweis}}<span class="shops-schau-hinweis">{{hinweis}}</span>{{/if}}
          </div>
          <span class="shops-schau-preis">{{preisText}}</span>
        </li>
      {{/each}}
    </ol>
  {{else}}
    <p class="shops-schau-leer">{{localize "SHOPS.Schau.Leer"}}</p>
  {{/if}}

  {{!--
    Der Fuß sagt, wie lange eine Seite noch steht. Ohne ihn rät der Saal.

    Eine **Sanduhr** und kein Fortschrittsbalken: Der Balken war die einzige
    Stelle, an der die Anzeige nach Software aussah statt nach einer Bude auf
    einem Marktplatz. Eine Sanduhr sagt dasselbe und gehört in die Welt — und
    sie sagt es sogar besser, weil jeder sie ohne Erklärung liest.
  --}}
  {{#if mehrereSeiten}}
    <footer class="shops-schau-fuss">
      <span class="shops-schau-seite">{{seite}} / {{seiten}}</span>

      {{#unless laeuft}}
        <span class="shops-schau-pause">{{localize "SHOPS.Schau.Angehalten"}}</span>
      {{/unless}}

      <span class="shops-sanduhr {{#unless laeuft}}shops-sanduhr-haelt{{/unless}}"
            role="img" aria-label="{{localize 'SHOPS.Schau.Sanduhr'}}">
        <svg viewBox="0 0 30 40" aria-hidden="true">
          <defs>
            {{!-- Zwei Trichter, an der Enge zusammengestoßen. Der Sand wird
                  daran beschnitten, damit er die Form füllt statt in einem
                  Rechteck zu stehen. --}}
            <clipPath id="shops-sand-oben">
              <path d="M5 4.6 H25 L16.1 18.6 H13.9 Z"></path>
            </clipPath>
            <clipPath id="shops-sand-unten">
              <path d="M13.9 21.4 H16.1 L25 35.4 H5 Z"></path>
            </clipPath>
          </defs>

          {{!--
            Der Beschnitt sitzt an einer **ruhenden Gruppe**, das bewegte
            Rechteck steckt darin. Am bewegten Element selbst wandert er mit:
            Ein `clip-path` wird im Koordinatensystem seines Elements
            aufgelöst, und das verschiebt die Verschiebung gleich mit — der
            Sand wurde dann nie beschnitten, sondern lief unten aus dem Glas
            heraus. So gesehen am 06.09.2026.
          --}}
          <g class="shops-sanduhr-sand">
            <g clip-path="url(#shops-sand-oben)">
              <rect class="shops-sand-oben" x="0" y="4" width="30" height="15"></rect>
            </g>
            <g clip-path="url(#shops-sand-unten)">
              <rect class="shops-sand-unten" x="0" y="21" width="30" height="15"></rect>
            </g>
            <rect class="shops-sand-faden" x="14.2" y="18" width="1.6" height="4"></rect>
          </g>

          <g class="shops-sanduhr-glas">
            <path d="M5 4.6 H25 L16.1 18.6 H13.9 Z"></path>
            <path d="M13.9 21.4 H16.1 L25 35.4 H5 Z"></path>
          </g>

          {{!-- Die Fassungen tragen das Gold, das Glas nur eine helle Kante —
                sonst verschwimmt der Sand mit seinem Behälter. --}}
          <g class="shops-sanduhr-fassung">
            <rect x="2.6" y="1.4" width="24.8" height="3.2" rx="1.6"></rect>
            <rect x="2.6" y="35.4" width="24.8" height="3.2" rx="1.6"></rect>
          </g>
        </svg>
      </span>
    </footer>
  {{/if}}

  {{!--
    Hier stand ein Hinweis „Escape schließt diese Ansicht". **Die Taste bleibt**
    — sie ist der einzige Weg heraus, denn die Schicht deckt auch den
    Ladenbogen mit ihrer Steuerung. Der Satz dazu ist weg: Die Schauansicht
    hängt an einer Wand und soll aussehen wie ein Regal, nicht wie ein
    Programm mit Bedienhinweisen. Wer sie öffnet, hat sie geöffnet und weiß
    es; nachzulesen ist es in der Anleitung.
  --}}

</div>

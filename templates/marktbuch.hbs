{{!--
  Das Marktbuch: alle Läden, auch was schiefging.

  Gescheitertes steht hier mit Grund — genau dafür schlägt man es auf. Das
  Ladenbuch zeigt dagegen nur, was durchging.
--}}
<div class="shops-teil-buch">

  <header class="shops-buchkopf">
    <label class="shops-buchfilter">
      <span>{{localize "SHOPS.Marktbuch.Laden"}}</span>
      <select data-ladenwahl>
        <option value="">{{localize "SHOPS.Marktbuch.AlleLaeden"}}</option>
        {{#each laeden}}
          <option value="{{uuid}}" {{#if gewaehlt}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </label>

    <span class="shops-buchzahl">
      {{anzahl}}
      {{#if gescheitert}}
        · <span class="shops-buch-fehlzahl">{{gescheitert}} {{localize "SHOPS.Marktbuch.Gescheitert"}}</span>
      {{/if}}
    </span>
  </header>

  {{#if zeilen.length}}
    <ol class="shops-buchliste">
      {{#each zeilen}}
        {{!-- Vier Faelle. Eine Freigabe ist keine Richtung: Es ist noch
              nichts geflossen, das tut erst die Kaufzeile danach. --}}
        <li class="shops-buchzeile {{#if freigabe}}shops-buch-frei{{else}}{{#unless ok}}shops-buch-fehl{{else}}{{#if gekauft}}shops-buch-kauf{{else}}shops-buch-verkauf{{/if}}{{/unless}}{{/if}}">
          <span class="shops-buch-pfeil">
            {{#if freigabe}}
              {{#if ok}}<i class="fa-solid fa-check"></i>
              {{else}}<i class="fa-solid fa-hand"></i>{{/if}}
            {{else}}{{#unless ok}}<i class="fa-solid fa-xmark"></i>
            {{else if gekauft}}<i class="fa-solid fa-arrow-right"></i>
            {{else}}<i class="fa-solid fa-arrow-left"></i>{{/unless}}{{/if}}
          </span>

          <div class="shops-buch-inhalt">
            <span class="shops-buch-was">
              {{wasText}}
              {{#if sonderpreis}}<em class="shops-buch-marke">{{localize "SHOPS.Buch.Sonderpreis"}}</em>{{/if}}
              {{!-- Ein Ja ist keine Warnung. Rot bleibt dem Nein. --}}
              {{#if freigabe}}<em class="shops-buch-marke{{#if ok}} shops-marke-ruhig{{/if}}">
                {{#if ok}}{{localize "SHOPS.Buch.Freigegeben"}}
                {{else}}{{localize "SHOPS.Buch.Abgelehnt"}}{{/if}}
              </em>{{/if}}
            </span>
            <span class="shops-buch-wer">
              {{zeitText}} · {{ladenName}} · {{userName}}{{#if figurName}} ({{figurName}}){{/if}}
              {{#if freigabeVon}} · {{localize "SHOPS.Buch.Durch"}} {{freigabeVon}}{{/if}}
            </span>
            {{#if satz}}<span class="shops-buch-satz">„{{satz}}"</span>{{/if}}
            {{#unless ok}}{{#unless freigabe}}
              <span class="shops-buch-grund">{{grundText}}</span>
            {{/unless}}{{/unless}}
          </div>

          <span class="shops-buch-summe">{{#if ok}}{{summeText}}{{else}}—{{/if}}</span>
        </li>
      {{/each}}
    </ol>
  {{else}}
    <p class="shops-leer shops-hinweisfeld">
      {{#if gefiltert}}{{localize "SHOPS.Marktbuch.NichtsGefiltert"}}
      {{else}}{{localize "SHOPS.Marktbuch.NochLeer"}}{{/if}}
    </p>
  {{/if}}

  <footer class="shops-buch-fuss">
    <span>{{localize "SHOPS.Marktbuch.Fusshinweis"}}</span>
    <button type="button" class="shops-zweit" data-action="leeren">
      <i class="fa-solid fa-trash"></i>
      {{localize "SHOPS.Marktbuch.Leeren"}}
    </button>
  </footer>
</div>

{{!--
  Vorzeigen: wer sieht diesen Laden gerade, und die Wege dorthin.

  Ein einziges Wurzelelement je PART, sonst wirft HandlebarsApplicationMixin
  beim Zeichnen. Siehe AGENTS.md.
--}}
<div class="shops-teil-vorzeigen">
  {{#if istGM}}
    <section class="shops-vorzeigen">
      <h3>{{localize "SHOPS.Vorzeigen.Titel"}}</h3>

      {{!-- Nur noch die drei Aktionen, die dieser Block verspricht. Die
            Buecher stehen im Fenstermenue: Zwei Symbolknoepfe daneben brachen
            um und waren ohne Beschriftung nicht zu lesen. --}}
      <div class="shops-vorzeigen-aktionen">
        <button type="button" data-action="zeigenAllen">
          <i class="fa-solid fa-users" aria-hidden="true"></i>
          {{localize "SHOPS.Vorzeigen.AllenZeigen"}}
        </button>
        <button type="button" class="shops-zweit" data-action="zeigenAuswahl">
          <i class="fa-solid fa-user-check" aria-hidden="true"></i>
          {{localize "SHOPS.Vorzeigen.AuswahlZeigen"}}
        </button>
        <button type="button" class="shops-zweit" data-action="schliessenAllen"
                {{#unless zuschauer.length}}disabled{{/unless}}>
          <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
          {{localize "SHOPS.Vorzeigen.AllenSchliessen"}}
        </button>
      </div>

      {{!-- Ohne Überschrift steht dort nur ein Name, und niemand weiß, was
            er bedeutet: Wer den Laden gerade offen hat. --}}
      <span class="shops-besucher-marke">
        {{localize "SHOPS.Vorzeigen.Besucher"}}
        {{#if zuschauer.length}}<span class="shops-anzahl">{{zuschauer.length}}</span>{{/if}}
      </span>

      {{!-- Die Steuerung der Schauansicht. Sie steht hier und nie auf dem
            Monitor: Der hat keine Tastatur. --}}
      {{#if schau}}
        <div class="shops-schau-steuer">
          <button type="button" data-action="schauZurueck"
                  data-tooltip="{{localize 'SHOPS.Schau.Zurueck'}}" aria-label="{{localize 'SHOPS.Schau.Zurueck'}}">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
          </button>
          <button type="button" data-action="schauHalt" class="shops-schau-halt">
            <i class="fa-solid {{#if schau.laeuft}}fa-pause{{else}}fa-play{{/if}}" aria-hidden="true"></i>
            <span>{{#if schau.laeuft}}{{localize "SHOPS.Schau.Halten"}}
                  {{else}}{{localize "SHOPS.Schau.Weiter"}}{{/if}}</span>
          </button>
          <button type="button" data-action="schauVor"
                  data-tooltip="{{localize 'SHOPS.Schau.Vor'}}" aria-label="{{localize 'SHOPS.Schau.Vor'}}">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
          <span class="shops-schau-stand">{{schau.seiteAnzeige}} / {{schau.seiten}}</span>
        </div>
      {{/if}}

      {{#if zuschauer.length}}
        <ul class="shops-zuschauer">
          {{#each zuschauer}}
            <li>
              <span class="{{#unless active}}shops-leer{{/unless}}">
                {{#if active}}<i class="fa-solid fa-circle shops-online" aria-hidden="true"></i>
                {{else}}<i class="fa-regular fa-circle" aria-hidden="true"></i>{{/if}}
                {{name}}
              </span>

              {{#if angebot}}
                <span class="shops-zuschauer-angebot"
                      title="{{localize 'SHOPS.Angebot.Offen'}}">
                  <i class="fa-solid fa-hand-holding" aria-hidden="true"></i>
                  {{angebot.name}} · {{angebot.preisText}}
                  <button type="button" data-action="angebotZurueck" data-user-id="{{id}}"
                          title="{{localize 'SHOPS.Angebot.Zuruecknehmen'}}" aria-label="{{localize 'SHOPS.Angebot.Zuruecknehmen'}}">
                    <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                  </button>
                </span>
              {{/if}}

              <button type="button" data-action="schliessenUser" data-user-id="{{id}}"
                      title="{{localize 'SHOPS.Vorzeigen.EinzelnSchliessen'}}" aria-label="{{localize 'SHOPS.Vorzeigen.EinzelnSchliessen'}}">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="shops-leer">{{localize "SHOPS.Vorzeigen.NiemandSieht"}}</p>
      {{/if}}
    </section>
  {{/if}}
</div>

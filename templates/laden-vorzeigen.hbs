{{!--
  Vorzeigen: wer sieht diesen Laden gerade, und die Wege dorthin.

  Ein einziges Wurzelelement je PART, sonst wirft HandlebarsApplicationMixin
  beim Zeichnen. Siehe AGENTS.md.
--}}
<div class="shops-teil-vorzeigen">
  {{#if istGM}}
    <section class="shops-vorzeigen">
      <h3>{{localize "SHOPS.Vorzeigen.Titel"}}</h3>

      {{!-- Zwei Gruppen: links, was den Laden zeigt, rechts, was ihn
            nachliest. Fünf gleich große Knöpfe nebeneinander sagten nichts
            darüber, welcher wozu gehört. --}}
      <div class="shops-vorzeigen-aktionen">
        <span class="shops-knopfgruppe shops-knopfgruppe-haupt">
          <button type="button" data-action="zeigenAllen">
            <i class="fa-solid fa-users"></i>
            {{localize "SHOPS.Vorzeigen.AllenZeigen"}}
          </button>
          <button type="button" class="shops-zweit" data-action="zeigenAuswahl">
            <i class="fa-solid fa-user-check"></i>
            {{localize "SHOPS.Vorzeigen.AuswahlZeigen"}}
          </button>
          <button type="button" class="shops-zweit" data-action="schliessenAllen"
                  {{#unless zuschauer.length}}disabled{{/unless}}>
            <i class="fa-solid fa-eye-slash"></i>
            {{localize "SHOPS.Vorzeigen.AllenSchliessen"}}
          </button>
        </span>

        <span class="shops-knopfgruppe shops-knopfgruppe-buecher">
          <button type="button" class="shops-zweit" data-action="ladenbuch"
                  title="{{localize 'SHOPS.Buch.Knopf'}}">
            <i class="fa-solid fa-scroll"></i>
          </button>
          <button type="button" class="shops-zweit" data-action="marktbuch"
                  title="{{localize 'SHOPS.Marktbuch.Knopf'}}">
            <i class="fa-solid fa-book"></i>
          </button>
        </span>
      </div>

      {{#if zuschauer.length}}
        <ul class="shops-zuschauer">
          {{#each zuschauer}}
            <li>
              <span class="{{#unless active}}shops-leer{{/unless}}">
                {{#if active}}<i class="fa-solid fa-circle shops-online"></i>
                {{else}}<i class="fa-regular fa-circle"></i>{{/if}}
                {{name}}
              </span>

              {{#if angebot}}
                <span class="shops-zuschauer-angebot"
                      title="{{localize 'SHOPS.Angebot.Offen'}}">
                  <i class="fa-solid fa-hand-holding"></i>
                  {{angebot.name}} · {{angebot.preisText}}
                  <button type="button" data-action="angebotZurueck" data-user-id="{{id}}"
                          title="{{localize 'SHOPS.Angebot.Zuruecknehmen'}}">
                    <i class="fa-solid fa-rotate-left"></i>
                  </button>
                </span>
              {{/if}}

              <button type="button" data-action="schliessenUser" data-user-id="{{id}}"
                      title="{{localize 'SHOPS.Vorzeigen.EinzelnSchliessen'}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="shops-leer">{{localize "SHOPS.Vorzeigen.NiemandSieht"}}</p>
      {{/if}}
    </section>
  {{/if}}
</div>

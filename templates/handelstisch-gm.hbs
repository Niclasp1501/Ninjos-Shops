{{!--
  Derselbe Tisch, von der anderen Seite.

  Die Spielleitung sieht, was der Spieler sieht — und kann zusätzlich die
  Seite der Person decken und den Preis setzen. Bewusst dieselbe Anordnung:
  Wer beide Fenster kennt, muss nicht zweimal lernen, wo was steht.
--}}
<div class="shops-teil-tisch">

  {{#if stand}}
    <header class="shops-tisch-kopf">
      {{#if stand.personBild}}<img src="{{stand.personBild}}" alt="">{{/if}}
      <div>
        <strong>{{stand.personName}}</strong>
        <span class="shops-tisch-satz">{{localize "SHOPS.Tisch.MitSpieler"
          spieler=spielerName figur=figurName}}</span>
      </div>
      {{#if boerse}}
        <span class="shops-boerse">
          <i class="fa-solid fa-coins" aria-hidden="true"></i>
          <span class="shops-boerse-label">{{figurName}}</span>
          <strong>{{boerse}}</strong>
        </span>
      {{/if}}
    </header>

    <div class="shops-tisch-platte">

      <section class="shops-tisch-seite" data-seite="nsc">
        <h3>{{localize "SHOPS.Tisch.SieGibt" person=stand.personName}}</h3>
        <ol class="shops-ware shops-tisch-nsc">
          {{#each stand.seiteNsc}}
            <li class="shops-zeile" data-item-id="{{itemId}}">
              {{#if img}}<img src="{{img}}" alt="" data-action="ansehen"
                              title="{{localize 'SHOPS.Ansehen.Knopf'}}">
              {{else}}<i class="fa-solid fa-cube shops-kein-bild" aria-hidden="true"></i>{{/if}}
              <div class="shops-name"><span class="shops-warenname">{{name}}</span></div>
              <span class="shops-menge">{{menge}}&times;</span>
              <span class="shops-preis">{{summeText}}</span>
              <button type="button" class="shops-tisch-weg" data-action="wegnehmen"
                      aria-label="{{localize 'SHOPS.Tisch.Wegnehmen'}}"
                      title="{{localize 'SHOPS.Tisch.Wegnehmen'}}">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            </li>
          {{/each}}
          {{#if stand.geldNsc}}
            <li class="shops-zeile shops-geldzeile">
              <i class="fa-solid fa-coins" aria-hidden="true"></i>
              <div class="shops-name"><span class="shops-warenname">{{localize "SHOPS.Tisch.Geld"}}</span></div>
              <span class="shops-preis">{{stand.geldNscText}}</span>
              <button type="button" class="shops-tisch-weg" data-action="geldWeg"
                      aria-label="{{localize 'SHOPS.Tisch.GeldWeg'}}"
                      title="{{localize 'SHOPS.Tisch.GeldWeg'}}">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            </li>
          {{/if}}
          {{#unless stand.seiteNsc.length}}{{#unless stand.geldNsc}}
            <li class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Tisch.NochNichtsHingelegt"}}</li>
          {{/unless}}{{/unless}}
        </ol>
        {{!-- Aussuchen passiert in einer Lage über dem Tisch — siehe
              tisch-wahl.js. Hier stehen nur die zwei Knöpfe, die sie öffnen. --}}
        <div class="shops-tisch-werkzeuge">
          <button type="button" class="shops-kaufen shops-zweit" data-action="wahlSachen">
            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
            {{localize "SHOPS.Tisch.Sachen"}}
          </button>
          <button type="button" class="shops-kaufen shops-zweit" data-action="wahlMuenzen">
            <i class="fa-solid fa-coins" aria-hidden="true"></i>
            {{localize "SHOPS.Tisch.Muenzen"}}
          </button>
        </div>
      </section>

      <section class="shops-tisch-seite" data-seite="spieler">
        <h3>{{localize "SHOPS.Tisch.ErGibt" spieler=spielerName}}</h3>
        <ol class="shops-ware shops-tisch-spieler">
          {{#each stand.seiteSpieler}}
            {{!-- Hier steht die Frage, die nur sie beantworten kann: Was ist
                  ihr das wert? Der Grundpreis daneben ist die Auskunft dazu,
                  die drei Zahlen darunter sind ihre Spanne. --}}
            <li class="shops-zeile shops-zeile-breit" data-item-id="{{itemId}}">
              <div class="shops-zeile-oben">
                {{#if img}}<img src="{{img}}" alt="">
                {{else}}<i class="fa-solid fa-cube shops-kein-bild" aria-hidden="true"></i>{{/if}}
                <div class="shops-name">
                  <span class="shops-warenname">{{name}}</span>
                  {{#if grundCp}}<small class="shops-grundpreis">{{localize "SHOPS.Tisch.Grundpreis"}} {{grundText}}</small>{{/if}}
                </div>
                <span class="shops-menge">{{menge}}&times;</span>
                <span class="shops-preis {{#if eigenerWert}}shops-fest{{/if}}">{{anrechnungText}}</span>
                <button type="button" class="shops-tisch-weg" data-action="wegnehmen"
                        aria-label="{{localize 'SHOPS.Tisch.Wegnehmen'}}"
                        title="{{localize 'SHOPS.Tisch.Wegnehmen'}}">
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </div>
              <div class="shops-zeile-unten">
                {{#each spanne}}
                  <button type="button" class="shops-klein" data-action="anrechnenSchnell" data-wert="{{cp}}">
                    {{text}}
                  </button>
                {{/each}}
                <span class="shops-preisfeld" data-anrechnung>
                  {{> "shops-muenzfelder" felder=anrechnungFelder}}
                </span>
                <button type="button" class="shops-klein" data-action="anrechnen">
                  {{localize "SHOPS.Tisch.Anrechnen"}}
                </button>
                {{#if eigenerWert}}
                  <button type="button" class="shops-klein" data-action="anrechnenFrei">
                    {{localize "SHOPS.Tisch.WiederRechnen"}}
                  </button>
                {{/if}}
              </div>
            </li>
          {{/each}}
          {{#if stand.geldSpieler}}
            <li class="shops-zeile shops-geldzeile">
              <i class="fa-solid fa-coins" aria-hidden="true"></i>
              <div class="shops-name"><span class="shops-warenname">{{localize "SHOPS.Tisch.Geld"}}</span></div>
              <span class="shops-preis">{{stand.geldSpielerText}}</span>
            </li>
          {{/if}}
          {{#unless stand.seiteSpieler.length}}{{#unless stand.geldSpieler}}
            <li class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Tisch.ErLegtNichts"}}</li>
          {{/unless}}{{/unless}}
        </ol>
      </section>
    </div>

    <div class="shops-tisch-waage {{#if stand.fehlt}}shops-zahlt{{/if}}
                {{#if stand.zuViel}}shops-bekommt{{/if}}">
      <span class="shops-tisch-summe">
        <small>{{localize "SHOPS.Tisch.Verlangt"}}</small> {{stand.verlangtText}}
      </span>
      <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
      <span class="shops-tisch-summe">
        <small>{{localize "SHOPS.Tisch.Hingelegt"}}</small> {{stand.gebrachtText}}
      </span>
      <strong class="shops-tisch-differenz">
        {{#if stand.ausgeglichen}}{{localize "SHOPS.Tisch.Ausgeglichen"}}
        {{else if stand.fehlt}}{{localize "SHOPS.Tisch.Fehlt" geld=stand.offenText}}
        {{else}}{{localize "SHOPS.Tisch.ZuViel" geld=stand.offenText}}{{/if}}
      </strong>
    </div>

    {{!-- Was sie für ihre Seite haben will. Vorgeschlagen ist die Summe ihrer
          Preise; was hier steht, gilt. --}}
    <div class="shops-tisch-preisfeld">
      <label>
        <span>{{localize "SHOPS.Tisch.SieVerlangt"}}</span>
        <span class="shops-preisfeld" data-forderung>
          {{> "shops-muenzfelder" felder=stand.forderungFelder}}
        </span>
      </label>
      <button type="button" class="shops-kaufen shops-zweit" data-action="forderungUebernehmen">
        {{localize "SHOPS.Tisch.PreisUebernehmen"}}
      </button>
      {{#if stand.ueberschrieben}}
        <button type="button" class="shops-kaufen shops-zweit" data-action="forderungFrei">
          {{localize "SHOPS.Tisch.WiederRechnen"}}
        </button>
      {{/if}}
    </div>

    <footer class="shops-tisch-fuss">
      {{!-- **Der Knopf sagt, was das Drücken jetzt bewirkt.** Vorher stand dort
            immer „Handel abschließen" — auch dann, wenn die andere Seite noch
            gar nicht zugesagt hatte und gar nichts abgeschlossen wurde. Also:
            zusagen, solange nur die eigene Zusage entsteht; abschließen erst,
            wenn die andere schon steht und der Druck den Tausch wirklich
            ausführt; und zurücknehmen, wenn man selbst schon zugesagt hat. --}}
      <button type="button" class="shops-kaufen {{#if stand.bereitGm}}shops-zweit{{/if}}"
              data-action="bestaetigen"
              {{#if stand.leer}}disabled
              {{else if stand.bereitGm}}
              {{else}}{{#unless stand.ausgeglichen}}disabled{{/unless}}{{/if}}>
        <i class="fa-solid {{#if stand.bereitGm}}fa-rotate-left{{else if stand.bereitSpieler}}fa-check{{else}}fa-handshake{{/if}}"
           aria-hidden="true"></i>
        {{#if stand.bereitGm}}{{localize "SHOPS.Tisch.ZusageZurueck"}}
        {{else if stand.bereitSpieler}}{{localize "SHOPS.Tisch.Abschliessen"}}
        {{else}}{{localize "SHOPS.Tisch.Zusagen"}}{{/if}}
      </button>
      {{#if stand.bereitGm}}
        <span class="shops-tisch-zusage">{{localize "SHOPS.Tisch.WartetAufIhn" spieler=spielerName}}</span>
      {{else if stand.bereitSpieler}}
        <span class="shops-tisch-zusage shops-zugesagt">{{localize "SHOPS.Tisch.ErHatZugesagt" spieler=spielerName}}</span>
      {{/if}}
      {{#if stand.zusageWegGm}}
        {{!-- Eine Zusage, die wegfaellt, faellt nicht stillschweigend weg. --}}
        <span class="shops-tisch-zusage shops-wartet">
          <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
          {{localize "SHOPS.Tisch.ZusageWeg"}}
        </span>
      {{/if}}
      <button type="button" class="shops-kaufen shops-zweit shops-abseits" data-action="beenden">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        {{localize "SHOPS.Tisch.Zuruecknehmen"}}
      </button>
      <span class="shops-blockhinweis">{{localize "SHOPS.Tisch.GMHinweis"}}</span>
    </footer>

    {{#if wahl}}{{> "shops-tisch-wahl" wahl=wahl}}{{/if}}

  {{else}}
    <p class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Tisch.KeinTisch"}}</p>
  {{/if}}
</div>

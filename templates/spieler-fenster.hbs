{{!--
  Spielerfenster: Kopfbild, Angebot, Auslage ohne Verborgenes, eigene Boerse.
  Preise sind Anzeige - beim Kauf rechnet die Spielleitung neu (Abschnitt 7).

  Ein einziges Wurzelelement je PART, sonst wirft HandlebarsApplicationMixin
  beim Zeichnen. Siehe AGENTS.md.
--}}
<div class="shops-teil-spieler">

  {{!-- Das Ladeninnere als breiter Streifen. `kopfFokus` sagt, welcher
        Ausschnitt zu sehen ist - ein Innenraum ist selten in der Mitte am
        interessantesten. --}}
  <header class="shops-banner" style="background-image: url('{{kopfbild}}'); background-position: 50% {{kopfFokus}}%;">
    <div class="shops-banner-text">
      <h2>{{ladenName}}</h2>
      {{#if haendler}}
        <span class="shops-verkaeufer" title="{{localize 'SHOPS.Haendler.Feld'}}">
          {{#if haendler.img}}<img src="{{haendler.img}}" alt="">{{/if}}
          {{haendler.name}}
        </span>
      {{/if}}
      {{#if begruessung}}<div class="shops-begruessung">{{{begruessung}}}</div>{{/if}}
    </div>
  </header>

  {{#if angebot}}
    {{!-- Ein Angebot der Spielleitung. Es steht oben und nicht in der Liste:
          Es ist keine Ware unter anderen, sondern etwas, das jemandem
          hingelegt wurde. --}}
    <section class="shops-angebot">
      <img src="{{angebot.img}}" alt="">
      <div class="shops-angebot-inhalt">
        <span class="shops-angebot-kopf">{{localize "SHOPS.Angebot.FuerDich"}}</span>
        <span class="shops-angebot-ware">
          {{#if angebot.mehrere}}{{angebot.menge}}&times; {{/if}}{{angebot.name}}
          <strong>{{angebot.summeText}}</strong>
        </span>
        {{#if angebot.text}}<span class="shops-angebot-satz">„{{angebot.text}}"</span>{{/if}}
      </div>
      <button type="button" class="shops-kaufen" data-action="angebotAnnehmen"
              {{#if keinSpielleiter}}disabled{{/if}}>
        <i class="fa-solid fa-hand-holding"></i>
        <span>{{localize "SHOPS.Angebot.Annehmen"}}</span>
      </button>
    </section>
  {{/if}}

  {{#if boerse}}
    <aside class="shops-boerse" title="{{localize 'SHOPS.Spieler.BoerseHinweis'}}">
      <span class="shops-boerse-label">
        <i class="fa-solid fa-coins"></i>
        {{#if figurName}}{{figurName}}{{else}}{{localize "SHOPS.Spieler.Boerse"}}{{/if}}
      </span>
      <span class="shops-boerse-muenzen">
        {{#each boerse}}
          <span class="shops-boerse-muenze">{{wert}}&nbsp;{{kuerzel}}</span>
        {{/each}}
      </span>
    </aside>
  {{else}}
    <aside class="shops-boerse shops-boerse-leer">
      <span class="shops-leer">{{localize "SHOPS.Spieler.KeineFigur"}}</span>
    </aside>
  {{/if}}

  <section class="shops-auslage shops-spieler-auslage">
    <h3>
      {{localize "SHOPS.Bogen.Auslage"}}
      <span class="shops-anzahl">{{ware.length}}</span>
    </h3>

    {{#if ware.length}}
      <ol class="shops-ware shops-spieler-ware">
        {{!-- Der Spaltenkopf steht **in** der Liste: Dort gilt fuer ihn und
              die Karten dieselbe Innenabstand- und Scrollleisten-Rechnung,
              und er bleibt beim Scrollen stehen. --}}
        <li class="shops-spalten shops-spieler-spalten">
          <span class="shops-spalte-bild"></span>
          <span class="shops-spalte-name">{{localize "SHOPS.Bogen.SpalteWare"}}</span>
          <span class="shops-spalte-menge">{{localize "SHOPS.Bogen.SpalteBestand"}}</span>
          <span class="shops-spalte-preis">{{localize "SHOPS.Bogen.SpaltePreis"}}</span>
          <span class="shops-spalte-kauf"></span>
        </li>

        {{#each ware}}
          <li class="shops-zeile {{#if ausverkauft}}shops-ausverkauft{{/if}} {{#if dienst}}shops-dienst{{/if}}"
              data-item-id="{{id}}">
            <img src="{{img}}" alt="">
            <div class="shops-name">
              <span class="shops-warenname">
                {{name}}
                {{#if dienst}}
                  <i class="fa-solid fa-handshake" title="{{localize 'SHOPS.Bogen.Dienst'}}"></i>
                {{/if}}
              </span>
              {{#if hinweis}}
                <span class="shops-hinweiszeile">{{hinweis}}</span>
              {{/if}}
            </div>

            <span class="shops-menge" title="{{localize 'SHOPS.Bogen.Menge'}}">
              {{#if dienst}}—{{else}}{{menge}}{{/if}}
            </span>

            <span class="shops-preis">{{preisText}}</span>

            {{!-- Der Knopf sagt, warum er nicht geht. Ein Knopf, der ohne
                  Begruendung aus ist, laesst jeden zweimal klicken. --}}
            {{#if @root.gesperrt}}
              <button type="button" class="shops-kaufen" disabled
                      title="{{localize 'SHOPS.Kauf.Gesperrt'}}">
                <i class="fa-solid fa-lock"></i>
                <span>{{localize "SHOPS.Spieler.NurAnsehen"}}</span>
              </button>
            {{else if ausverkauft}}
              <button type="button" class="shops-kaufen" disabled>
                <span>{{localize "SHOPS.Spieler.Ausverkauft"}}</span>
              </button>
            {{else if @root.keinSpielleiter}}
              <button type="button" class="shops-kaufen" disabled
                      title="{{localize 'SHOPS.Kauf.KeinSpielleiter'}}">
                <span>{{localize "SHOPS.Spieler.NiemandDa"}}</span>
              </button>
            {{else}}
              <button type="button" class="shops-kaufen {{#if zuTeuer}}shops-knapp{{/if}}"
                      data-action="kaufen"
                      title="{{#if zuTeuer}}{{localize 'SHOPS.Kauf.ZuWenigGeld'}}{{/if}}">
                <i class="fa-solid fa-hand-holding"></i>
                <span>{{localize "SHOPS.Spieler.Kaufen"}}</span>
              </button>
            {{/if}}
          </li>
        {{/each}}
      </ol>
    {{else}}
      <p class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Spieler.AuslageLeer"}}</p>
    {{/if}}
  </section>

  {{!-- Der Weg zur Anfrage steht immer da, auch wenn der Laden nichts ohne
        Frage nimmt: Sonst haette ein Spieler bei so einem Laden gar keinen
        Weg, etwas loszuwerden. --}}
  <section class="shops-anfrage-start">
    <button type="button" class="shops-kaufen shops-zweit" data-action="anfrageStellen">
      <i class="fa-solid fa-hand-holding"></i>
      <span>{{localize "SHOPS.Anfrage.Knopf"}}</span>
    </button>
    <span class="shops-leer">{{localize "SHOPS.Anfrage.KnopfHinweis"}}</span>
  </section>

  {{#if kauftAn}}
    {{!-- Der Weg zurueck. Er steht unter der Auslage, nicht daneben: Zuerst
          sieht man, was es gibt, und erst dann, was man loswerden kann. --}}
    <section class="shops-verkauf">
      <h3>
        {{localize "SHOPS.Verkauf.Ueberschrift"}}
        <span class="shops-anzahl">{{verkauf.length}}</span>
      </h3>

      {{#if verkauf.length}}
        <ol class="shops-ware shops-verkauf-liste">
          {{#each verkauf}}
            <li class="shops-zeile {{#if wertlos}}shops-ausverkauft{{/if}}" data-item-id="{{id}}">
              <img src="{{img}}" alt="">
              <div class="shops-name">
                <span class="shops-warenname">{{name}}</span>
              </div>
              <span class="shops-menge">{{menge}}</span>
              <span class="shops-preis">{{preisText}}</span>
              {{#if wertlos}}
                <button type="button" class="shops-kaufen" disabled
                        title="{{localize 'SHOPS.Verkauf.Wertlos'}}">
                  <span>{{localize "SHOPS.Verkauf.Wertlos"}}</span>
                </button>
              {{else}}
                <button type="button" class="shops-kaufen" data-action="verkaufen"
                        {{#if @root.keinSpielleiter}}disabled{{/if}}>
                  <i class="fa-solid fa-hand-holding"></i>
                  <span>{{localize "SHOPS.Verkauf.Knopf"}}</span>
                </button>
              {{/if}}
            </li>
          {{/each}}
        </ol>
      {{else}}
        <p class="shops-leer shops-hinweisfeld">{{localize "SHOPS.Verkauf.NichtsDabei"}}</p>
      {{/if}}
    </section>
  {{/if}}

  {{#if freigabe}}
    <p class="shops-spieler-fuss">{{localize "SHOPS.Kauf.BrauchtFreigabe"}}</p>
  {{/if}}
</div>
